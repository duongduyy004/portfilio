---
import type { Role } from '../data/types';
import StatCounter from './StatCounter.astro';
import ZoomImage from './ZoomImage.astro';

interface Props {
  role: Role;
}

const { role } = Astro.props;
---

<article class="role card" data-reveal="drop" id={`role-${role.id}`}>
  <div class="role__head">
    <span class="role__pin" data-reveal="pop">📌 Pinned</span>
    <h3 class="role__title">{role.title}</h3>
    <p class="role__company">{role.company}</p>
    {role.dates && <p class="role__dates">{role.dates}</p>}
  </div>

  <div class="role__metrics">
    {role.metrics.map((m) => <StatCounter stat={m} />)}
  </div>

  <ul class="role__bullets">
    {role.bullets.map((b) => <li>{b}</li>)}
  </ul>

  <div class="role__photos">
    {role.photos.slice(0, 3).map((p) => (
      <ZoomImage photo={p} caption={`${role.company} — ${p.alt}`} widths={[240, 480]} sizes="(min-width: 900px) 300px, 30vw" />
    ))}
  </div>

  <details class="role__story">
    <summary>Read the full story</summary>
    <div class="role__story-body">
      {role.story.map((p) => <p>{p}</p>)}
    </div>
  </details>
</article>

<style>
  .role {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 22px;
  }
  .role + :global(.role) { margin-top: 24px; }
  .role__pin {
    display: inline-block;
    font-size: 12px;
    font-weight: 700;
    background: var(--yellow);
    border: var(--border);
    border-radius: 999px;
    padding: 2px 10px;
    margin-bottom: 10px;
  }
  .role__title { font-size: clamp(20px, 4vw, 26px); }
  .role__company { font-weight: 600; color: #5638E0; margin-top: 2px; }
  .role__dates { font-size: 14px; color: var(--muted); }
  .role__metrics {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
    gap: 12px;
    padding: 14px;
    background: var(--bg);
    border: var(--border);
    border-radius: 14px;
  }
  .role__bullets { margin: 0; padding-left: 20px; display: grid; gap: 6px; }
  .role__photos {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
  }
  .role__photos :global(img) {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border: var(--border);
    border-radius: 12px;
  }
  .role__story summary {
    cursor: pointer;
    font-weight: 700;
    display: inline-block;
    padding: 8px 16px;
    border: var(--border);
    border-radius: 999px;
    background: var(--mint);
    list-style: none;
  }
  .role__story summary::-webkit-details-marker { display: none; }
  .role__story summary::after { content: ' ↓'; }
  .role__story[open] summary::after { content: ' ↑'; }
  .role__story-body { display: grid; gap: 12px; margin-top: 14px; max-width: 70ch; }
</style>
