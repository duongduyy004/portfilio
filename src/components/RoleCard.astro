---
import type { Role } from '../data/types';
import StatCounter from './StatCounter.astro';
import ZoomImage from './ZoomImage.astro';

interface Props {
  role: Role;
}

const { role } = Astro.props;
---

<article class="role card" data-reveal="drop" data-tilt="2" id={`role-${role.id}`}>
  <div class="role__head">
    <span class="role__pin" data-reveal="pop">📌 Pinned</span>
    <h3 class="role__title">{role.title}</h3>
    <p class="role__company">{role.company}</p>
    {role.dates && <p class="role__dates">{role.dates}</p>}
  </div>

  <div class="role__metrics">
    {role.metrics.map((m) => <StatCounter stat={m} />)}
  </div>

  <ul class="role__bullets">
    {role.bullets.map((b) => <li>{b}</li>)}
  </ul>

  <div class="role__photos">
    {role.photos.slice(0, 3).map((p) => (
      <ZoomImage photo={p} caption={`${role.company} — ${p.alt}`} widths={[240, 480]} sizes="(min-width: 900px) 300px, 30vw" />
    ))}
  </div>

  <details class="role__story">
    <summary>Read the full story</summary>
    <div class="role__story-body">
      {role.story.map((p) => <p>{p}</p>)}
    </div>
  </details>
</article>

<script>
  // Fitted slides open the longer story in a readable dialog. If fitting is unavailable,
  // keep the native details flow and pin the card's top while it expands.
  const pinned = new Set<HTMLElement>();
  for (const story of document.querySelectorAll<HTMLDetailsElement>('.role__story')) {
    const inner = story.closest<HTMLElement>('.slide__inner');
    if (!inner) continue;
    // click runs before the summary's default toggle, so the layout is still the closed one
    const summary = story.querySelector('summary')!;
    summary.setAttribute('aria-haspopup', 'dialog');
    const dialog = document.createElement('dialog');
    dialog.className = 'modal-shell story-modal';
    const close = document.createElement('button');
    close.type = 'button';
    close.className = 'btn modal-shell__close';
    close.textContent = 'Close ×';
    const frame = document.createElement('div');
    frame.className = 'modal-shell__frame story-modal__frame';
    const heading = document.createElement('h3');
    heading.textContent = story.closest('.role')?.querySelector('.role__title')?.textContent ?? 'Full story';
    dialog.setAttribute('aria-label', heading.textContent);
    frame.append(heading, story.querySelector('.role__story-body')!.cloneNode(true));
    dialog.append(close, frame);
    document.body.append(dialog);
    close.addEventListener('click', () => dialog.close());
    dialog.addEventListener('close', () => summary.focus({ preventScroll: true }));
    dialog.addEventListener('click', (event) => {
      const rect = dialog.getBoundingClientRect();
      if (event.target === dialog && (event.clientX < rect.left || event.clientX > rect.right || event.clientY < rect.top || event.clientY > rect.bottom)) dialog.close();
    });
    summary.addEventListener('click', (event) => {
      if (document.documentElement.classList.contains('deck-fit')) {
        event.preventDefault();
        dialog.showModal();
        return;
      }
      if (story.open) return;
      inner.style.marginTop = getComputedStyle(inner).marginTop;
      pinned.add(inner);
    });
    story.addEventListener('toggle', () => {
      if (story.open) return;
      inner.style.marginTop = '';
      pinned.delete(inner);
    });
  }
  addEventListener('resize', () => {
    for (const inner of pinned) inner.style.marginTop = '';
    pinned.clear();
  });
</script>

<style>
  .role {
    display: flex;
    flex-direction: column;
    gap: var(--card-gap);
    padding: var(--card-padding);
    font-size: var(--card-body-size);
    line-height: 1.65;
    text-align: center;
  }
  .role + :global(.role) { margin-top: 24px; }
  .role__pin {
    display: inline-block;
    font-size: 12px;
    font-weight: 700;
    background: var(--yellow);
    border: var(--border);
    border-radius: 999px;
    padding: 2px 10px;
    margin-bottom: 10px;
  }
  .role__title { font-size: clamp(20px, 4vw, 26px); }
  .role__company { font-weight: 600; color: #5638E0; margin-top: 2px; }
  .role__dates { font-size: 14px; color: var(--muted); }
  .role__metrics {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px 16px;
    padding: 14px;
    background: var(--bg);
    border: var(--border);
    border-radius: 14px;
  }
  .role__bullets { margin: auto; max-width: 60ch; padding-left: 20px; display: grid; gap: 12px; text-align: left; }
  .role__photos {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
    width: 100%;
    max-width: 720px;
    margin-inline: auto;
  }
  .role__photos :global(img) {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border: var(--border);
    border-radius: 12px;
  }
  .role__story summary {
    cursor: pointer;
    font-weight: 700;
    display: inline-block;
    padding: 8px 16px;
    border: var(--border);
    border-radius: 999px;
    background: var(--mint);
    list-style: none;
  }
  .role__story summary::-webkit-details-marker { display: none; }
  .role__story summary::after { content: ' ↓'; }
  .role__story[open] summary::after { content: ' ↑'; }
  .role__story-body { display: grid; gap: 20px; margin: 20px auto 0; max-width: 70ch; }
  :global(.story-modal) { width: min(900px, calc(100vw - 32px)); }
  :global(.story-modal__frame) {
    padding: clamp(20px, 3vw, 32px);
    max-height: calc(100dvh - 120px);
    overflow-y: auto;
    scrollbar-width: none;
    font-size: clamp(16px, 1.6vw, 20px);
    line-height: 1.65;
  }
  :global(.story-modal__frame::-webkit-scrollbar) { display: none; }
</style>
