---
import { Image } from 'astro:assets';
import ZoomImage from './ZoomImage.astro';
import type { Video } from '../data/types';
import { embedUrl } from '../lib/embed';
import { linkState } from '../lib/link';

interface Props {
  video: Video;
}

const { video } = Astro.props;
const link = linkState(video.url);
const embed = embedUrl(video.kind, link.href ?? undefined);
const posterSrc = typeof video.poster === 'string' ? video.poster : undefined;
const posterImage = typeof video.poster === 'string' ? undefined : video.poster;
// both her own files and parseable YouTube/TikTok links play in the shared VideoModal
const modalData = {
  'data-video-modal': '',
  'data-kind': video.kind,
  'data-title': video.title,
  'data-caption': video.caption,
};
// one 'coming soon' per card, naming the platform when there is one
const soonLabel = { youtube: 'YouTube', tiktok: 'TikTok', link: 'Link', file: '' }[video.kind];
---

<article class="video card" data-reveal="drop" data-tilt>
  <div class="video__media">
    {video.kind === 'file' ? (
      <a class="video__poster" href={video.src} {...modalData} data-poster={posterSrc} aria-label={`Play ${video.title}`}>
        {posterSrc && <img src={posterSrc} alt="" loading="lazy" decoding="async" />}
        <span class="video__play" aria-hidden="true">▶</span>
      </a>
    ) : link.href ? (
      <a
        class="video__poster"
        href={link.href}
        target="_blank"
        rel="noopener"
        {...(embed ? { ...modalData, 'data-embed': embed } : {})}
        aria-label={embed ? `Play ${video.title}` : `${video.title}, opens in new tab`}
      >
        {posterImage && <Image src={posterImage.src} alt="" widths={[320, 640]} sizes="(min-width: 960px) 340px, 90vw" />}
        <span class="video__play" aria-hidden="true">{embed ? '▶' : '↗'}</span>
      </a>
    ) : (
      <div class="video__poster video__poster--soon">
        {posterImage && (
          <ZoomImage class="video__zoom" photo={posterImage} caption={`${video.title} — ${posterImage.alt}`} widths={[320, 640]} sizes="(min-width: 960px) 340px, 90vw" />
        )}
        <span class="video__soon">{soonLabel} coming soon</span>
      </div>
    )}
  </div>
  <div class="video__body">
    <h3>{video.title}</h3>
    {video.caption && <p>{video.caption}</p>}
  </div>
</article>

<style>
  .video { display: flex; flex-direction: column; }
  .video__media {
    position: relative;
    height: clamp(100px, 22dvh, 200px);
    background: var(--ink);
    border-bottom: var(--border);
  }
  .video__media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    border: 0;
  }
  .video__poster { display: block; position: absolute; inset: 0; }
  .video__poster[data-video-modal] { cursor: pointer; }
  .video__poster[data-video-modal]:hover .video__play { transform: scale(1.08); }
  .video__play {
    transition: transform .15s;
    position: absolute;
    left: 50%;
    top: 50%;
    translate: -50% -50%;
    display: grid;
    place-items: center;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: var(--yellow);
    border: var(--border);
    box-shadow: var(--shadow);
    font-size: 24px;
  }
  .video__poster--soon :global(.video__zoom) { position: absolute; inset: 0; }
  .video__poster--soon :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; filter: grayscale(.4); opacity: .85; }
  .video__soon { pointer-events: none; }
  .video__soon {
    position: absolute;
    left: 12px;
    bottom: 12px;
    font-size: 13px;
    font-weight: 700;
    background: var(--card);
    border: var(--border);
    border-radius: 999px;
    padding: 2px 10px;
  }
  .video__body { padding: var(--card-padding); display: grid; align-content: center; flex: 1; text-align: center; gap: var(--card-gap); }
  h3 { font-size: var(--card-title-size); }
  p { font-size: var(--card-body-size); line-height: 1.65; color: var(--muted); }
</style>
