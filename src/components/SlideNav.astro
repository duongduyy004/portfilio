---
interface Props {
  slides: { n: number; id: string; title: string }[];
}

const { slides } = Astro.props;
---

<!-- plain anchor links, so the dots work without JS too -->
<nav class="slidenav" aria-label="Slides">
  <ol>
    {slides.map((s) => (
      <li>
        <a href={`#${s.id}`} class="slidenav__dot" data-dot={s.n} data-magnet="16"><span class="slidenav__label">{s.title}</span></a>
      </li>
    ))}
  </ol>
</nav>

<style>
  .slidenav {
    position: fixed;
    left: 50%;
    bottom: 16px;
    translate: -50% 0;
    z-index: 9;
    background: var(--card);
    border: var(--border);
    border-radius: 999px;
    padding: 2px 6px;
  }
  .slidenav ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
  }
  /* 24×24 tap target (WCAG 2.5.8) around a 12px dot */
  .slidenav__dot {
    position: relative;
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    border-radius: 50%;
  }
  .slidenav__dot::before {
    content: '';
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--card);
    border: var(--border);
    box-sizing: border-box;
  }
  .slidenav__dot[aria-current="true"]::before { background: var(--ink); }
  /* visually hidden on phones (it would cover the slide) but still the link's accessible name */
  .slidenav__label {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
  @media (min-width: 640px) {
    .slidenav__label {
      width: auto;
      height: auto;
      overflow: visible;
      clip: auto;
      bottom: calc(100% + 8px);
      left: 50%;
      translate: -50% 0;
      font-size: 13px;
      font-weight: 700;
      color: var(--ink);
      background: var(--card);
      border: var(--border);
      border-radius: 999px;
      padding: 2px 10px;
      opacity: 0;
      pointer-events: none;
      transition: opacity .15s;
    }
    .slidenav__dot:hover .slidenav__label,
    .slidenav__dot:focus-visible .slidenav__label { opacity: 1; }
  }
</style>

<script>
  import { counterText, currentSlideX, navKey, wheelStep } from '../lib/slidenav';

  const deck = document.querySelector<HTMLElement>('[data-deck]')!;
  const slides = [...deck.querySelectorAll<HTMLElement>('[data-slide]')];
  const last = slides.length - 1;
  const counter = document.querySelector<HTMLElement>('[data-slide-counter]');
  const live = document.querySelector<HTMLElement>('[data-slide-live]');
  const dots = [...document.querySelectorAll<HTMLElement>('[data-dot]')];
  const tabs = [...document.querySelectorAll<HTMLElement>('[data-tab-section]')];
  const prevBtn = document.querySelector<HTMLButtonElement>('[data-deck-prev]');
  const nextBtn = document.querySelector<HTMLButtonElement>('[data-deck-next]');
  const wide = window.matchMedia('(min-width: 640px)');
  const behavior: ScrollBehavior = window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth';
  const dialogOpen = () => document.querySelector('dialog[open]') !== null;

  counter?.removeAttribute('hidden');
  // navigation is live: its controls replace the deck scrollbar (kept if this script never runs)
  document.documentElement.classList.add('deck-nav');

  const canScrollDown = (s: HTMLElement) => s.scrollTop + s.clientHeight < s.scrollHeight - 1;
  const canScrollUp = (s: HTMLElement) => s.scrollTop > 0;

  let current = -1;
  // where an in-flight move is heading, so quick repeated presses step from there, not from `current`
  let target = -1;
  const pos = () => (target >= 0 ? target : current);

  function goTo(i: number, focus = true) {
    target = Math.max(0, Math.min(last, i));
    deck.scrollTo({ left: target * deck.clientWidth, behavior });
    if (focus) slides[target].focus({ preventScroll: true });
  }

  function updateArrows() {
    const hadFocus = document.activeElement;
    if (prevBtn) prevBtn.hidden = !wide.matches || current <= 0;
    if (nextBtn) nextBtn.hidden = !wide.matches || current >= last;
    // hiding the focused arrow (at either end) would drop focus to <body>: hand it on instead
    if ((hadFocus === prevBtn && prevBtn?.hidden) || (hadFocus === nextBtn && nextBtn?.hidden)) {
      const other = hadFocus === prevBtn ? nextBtn : prevBtn;
      (other && !other.hidden ? other : slides[current]).focus({ preventScroll: true });
    }
  }

  function updateHint(s: HTMLElement) {
    const hint = s.querySelector<HTMLElement>('.slide__more');
    if (hint) hint.hidden = s.scrollTop + s.clientHeight >= s.scrollHeight - 8;
  }

  let announceTimer: number | undefined;
  function announce(i: number) {
    clearTimeout(announceTimer);
    announceTimer = window.setTimeout(() => {
      if (live) live.textContent = `Slide ${i + 1} of ${slides.length}: ${slides[i].dataset.title ?? ''}`;
    }, 400);
  }

  // hash rewriting starts only after any deep link has been honoured
  let hashReady = false;

  function update() {
    const i = currentSlideX(deck.scrollLeft, deck.clientWidth, slides.length);
    if (i === current) return;
    const first = current === -1;
    current = i;
    accumulated = 0;
    const slide = slides[i];
    slides.forEach((s, j) => s.toggleAttribute('data-current', j === i));
    if (counter) counter.textContent = counterText(i, slides.length);
    dots.forEach((d, j) => (j === i ? d.setAttribute('aria-current', 'true') : d.removeAttribute('aria-current')));
    tabs.forEach((t) =>
      t.dataset.tabSection === slide.dataset.section ? t.setAttribute('aria-current', 'true') : t.removeAttribute('aria-current'),
    );
    updateArrows();
    updateHint(slide);
    if (hashReady) {
      try {
        history.replaceState(null, '', `#${slide.id}`);
      } catch {
        // Safari rate-limits replaceState (100 per 10s); the URL is a nicety, navigation isn't
      }
    }
    if (!first) announce(i);
  }

  // once the deck stops moving: slides you've left start at the top next time. Doing this only on
  // settle keeps a half-swiped (or snapped-back) slide exactly where the reader left it.
  function settle() {
    update(); // scroll events are rAF-throttled: make sure `current` reflects where the deck stopped
    target = -1;
    slides.forEach((s, j) => {
      if (j !== current && s.scrollTop !== 0) s.scrollTop = 0;
    });
    // a swipe moves the deck but not focus; bring focus along if it was on a slide now off screen
    const active = document.activeElement;
    const owner = slides.find((s) => s.contains(active));
    if (owner && owner !== slides[current]) slides[current].focus({ preventScroll: true });
  }
  let settleTimer: number | undefined;
  deck.addEventListener('scrollend', () => {
    clearTimeout(settleTimer);
    settle();
  });

  let ticking = false;
  deck.addEventListener(
    'scroll',
    () => {
      clearTimeout(settleTimer);
      settleTimer = window.setTimeout(settle, 150); // fallback where scrollend isn't supported
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        ticking = false;
        update();
      });
    },
    { passive: true },
  );
  slides.forEach((s) => s.addEventListener('scroll', () => updateHint(s), { passive: true }));

  // stay on the same slide when the deck changes size (rotation, mobile browser bars)
  window.addEventListener('resize', () => {
    if (current >= 0) deck.scrollTo({ left: current * deck.clientWidth, behavior: 'auto' });
    updateArrows();
    slides.forEach(updateHint);
  });
  wide.addEventListener('change', updateArrows);

  // keep focus on the button so keyboard users can press it again
  prevBtn?.addEventListener('click', () => goTo(pos() - 1, false));
  nextBtn?.addEventListener('click', () => goTo(pos() + 1, false));

  // dots and tabs are plain anchors (they work without JS); with JS, slide there smoothly instead
  document.addEventListener('click', (e) => {
    if (e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
    const link = (e.target as HTMLElement).closest<HTMLAnchorElement>('a[href^="#slide-"]');
    if (!link) return;
    // the skip link targets slide 1 for no-JS; with JS it lands on the slide being shown
    if (link.hasAttribute('data-skip')) {
      e.preventDefault();
      slides[Math.max(current, 0)].focus({ preventScroll: true });
      return;
    }
    const i = slides.findIndex((s) => `#${s.id}` === link.getAttribute('href'));
    if (i < 0) return;
    e.preventDefault();
    goTo(i);
  });

  document.addEventListener('keydown', (e) => {
    const active = document.activeElement as HTMLElement | null;
    const action = navKey(e, { tag: active?.tagName ?? 'BODY', dialogOpen: dialogOpen() });
    const slide = slides[current];
    if (!action) {
      // ↑/↓ scroll the current slide whenever focus is outside the slides (page, tabs, dots,
      // arrows) — the document itself never scrolls; inside a slide the browser handles them
      const outsideSlides = !active || !slides.some((s) => s.contains(active));
      if (outsideSlides && !dialogOpen() && !e.altKey && !e.ctrlKey && !e.metaKey && (e.key === 'ArrowDown' || e.key === 'ArrowUp')) {
        e.preventDefault();
        slide.scrollBy({ top: e.key === 'ArrowDown' ? 40 : -40 });
      }
      return;
    }
    e.preventDefault();
    if (action === 'next') return goTo(pos() + 1);
    if (action === 'prev') return goTo(pos() - 1);
    if (action === 'first') return goTo(0);
    if (action === 'last') return goTo(last);
    const page = slide.clientHeight * 0.85;
    if (action === 'page-next') {
      if (canScrollDown(slide)) slide.scrollBy({ top: page, behavior });
      else goTo(pos() + 1);
    } else {
      if (canScrollUp(slide)) slide.scrollBy({ top: -page, behavior });
      else goTo(pos() - 1);
    }
  });

  // vertical wheel: scroll inside the slide; at its edge, a firm push moves one slide
  let accumulated = 0;
  let cooldownUntil = 0;
  let lastWheel = 0;
  deck.addEventListener(
    'wheel',
    (e) => {
      if (dialogOpen() || e.ctrlKey) return;
      if (Math.abs(e.deltaX) > Math.abs(e.deltaY)) return; // sideways trackpad: native snap
      const slide = slides[current];
      const dy = e.deltaMode === 1 ? e.deltaY * 16 : e.deltaMode === 2 ? e.deltaY * slide.clientHeight : e.deltaY;
      const down = canScrollDown(slide);
      const up = canScrollUp(slide);
      const now = performance.now();
      // a pause of 300ms ends the gesture: leftover residue must not add up across minutes
      if (now - lastWheel > 300) accumulated = 0;
      lastWheel = now;
      if (now < cooldownUntil) {
        // after a slide change, swallow the rest of the gesture entirely: momentum must neither
        // move another slide nor scroll the slide just arrived on. It ends after a 250ms pause.
        e.preventDefault();
        cooldownUntil = Math.max(cooldownUntil, now + 250);
        return;
      }
      const step = wheelStep(dy, down, up, accumulated);
      if (!step.consume) {
        accumulated = 0;
        return;
      }
      e.preventDefault();
      accumulated = step.accumulated;
      if (step.move !== 0) {
        cooldownUntil = performance.now() + 700;
        goTo(pos() + step.move);
      }
    },
    { passive: false },
  );

  // deep links: #slide-N or a legacy section anchor (#events) open on their slide
  function slideForHash(hash: string): number {
    if (!hash || hash === '#') return -1;
    const el = document.getElementById(decodeURIComponent(hash.slice(1)));
    const owner = el?.closest<HTMLElement>('[data-slide]');
    return owner ? slides.indexOf(owner) : -1;
  }
  const initial = slideForHash(location.hash);
  if (initial >= 0) deck.scrollTo({ left: initial * deck.clientWidth, behavior: 'auto' });
  update();
  hashReady = true;
</script>
