---
interface Props {
  slides: { n: number; id: string; title: string }[];
}

const { slides } = Astro.props;
---

<!-- plain anchor links, so the dots work without JS too -->
<nav class="slidenav" aria-label="Slides">
  <ol>
    {slides.map((s) => (
      <li>
        <a href={`#${s.id}`} class="slidenav__dot" data-dot={s.n}><span class="slidenav__label">{s.title}</span></a>
      </li>
    ))}
  </ol>
</nav>

<style>
  .slidenav {
    position: fixed;
    left: 50%;
    bottom: 16px;
    translate: -50% 0;
    z-index: 9;
    background: var(--card);
    border: var(--border);
    border-radius: 999px;
    padding: 6px 10px;
  }
  .slidenav ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 8px;
  }
  .slidenav__dot {
    position: relative;
    display: block;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--card);
    border: var(--border);
  }
  .slidenav__dot[aria-current="true"] { background: var(--ink); }
  .slidenav__label {
    position: absolute;
    bottom: calc(100% + 12px);
    left: 50%;
    translate: -50% 0;
    white-space: nowrap;
    font-size: 13px;
    font-weight: 700;
    color: var(--ink);
    background: var(--card);
    border: var(--border);
    border-radius: 999px;
    padding: 2px 10px;
    opacity: 0;
    pointer-events: none;
    transition: opacity .15s;
  }
  /* on phones the label would cover the slide; the counter in the tab bar says where you are */
  .slidenav__label { display: none; }
  @media (min-width: 640px) {
    .slidenav__label { display: block; }
    .slidenav__dot:hover .slidenav__label,
    .slidenav__dot:focus-visible .slidenav__label { opacity: 1; }
  }
</style>
