---
import type { SectionId } from '../data/slides';

interface Props {
  sections: readonly { id: SectionId; label: string }[];
  firstSlide: Record<SectionId, string>;
  total: number;
}

const { sections, firstSlide, total } = Astro.props;
---

<nav class="tabbar" aria-label="Sections">
  <div class="tabbar__row container">
    <ul class="tabbar__list">
      {sections.map((s) => (
        <li><a class="tabbar__tab" href={`#${firstSlide[s.id]}`} data-tab-section={s.id}>{s.label}</a></li>
      ))}
    </ul>
    <!-- shown by SlideNav's script; meaningless without it -->
    <span class="tabbar__counter" data-slide-counter aria-live="polite" hidden>01 / {total}</span>
  </div>
</nav>

<style>
  .tabbar {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in srgb, var(--bg) 92%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 2px solid var(--ink);
  }
  .tabbar__row {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .tabbar__list {
    flex: 1;
    min-width: 0;
    display: flex;
    gap: 8px;
    list-style: none;
    margin: 0;
    padding: 10px 0;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .tabbar__list::-webkit-scrollbar { display: none; }
  .tabbar__tab {
    display: inline-block;
    white-space: nowrap;
    text-decoration: none;
    font-weight: 600;
    font-size: 14px;
    padding: 7px 16px;
    border-radius: 999px;
    border: var(--border);
    background: var(--card);
  }
  .tabbar__tab[aria-current="true"] {
    background: var(--ink);
    color: #fff;
  }
  .tabbar__counter {
    flex: none;
    font-weight: 700;
    font-size: 14px;
    font-variant-numeric: tabular-nums;
    padding: 6px 12px;
    border: var(--border);
    border-radius: 999px;
    background: var(--yellow);
  }
</style>
