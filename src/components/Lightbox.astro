<dialog id="lightbox" class="lightbox" aria-label="Photo viewer">
  <button type="button" class="lightbox__close btn" aria-label="Close" data-close>✕</button>
  <figure class="lightbox__figure">
    <img class="lightbox__img" alt="" />
    <figcaption class="lightbox__caption"></figcaption>
  </figure>
</dialog>

<style>
  .lightbox {
    width: min(1100px, 100vw - 24px);
    max-height: calc(100dvh - 24px);
    padding: 0;
    border: var(--border);
    border-radius: var(--radius);
    background: var(--card);
    box-shadow: 0 6px 0 var(--ink);
    overflow: hidden;
  }
  .lightbox::backdrop { background: rgb(22 19 31 / .75); }
  .lightbox__figure { margin: 0; display: flex; flex-direction: column; }
  .lightbox__img {
    width: 100%;
    max-height: calc(100dvh - 120px);
    object-fit: contain;
    background: var(--ink);
  }
  .lightbox__caption { padding: 12px 16px; font-size: 15px; }
  .lightbox__close {
    position: absolute;
    top: 10px;
    right: 10px;
    padding: 6px 12px;
  }
</style>

<script>
  const dialog = document.getElementById('lightbox') as HTMLDialogElement;
  const img = dialog.querySelector('img')!;
  const caption = dialog.querySelector('figcaption')!;
  let opener: HTMLElement | null = null;

  document.addEventListener('click', (event) => {
    const trigger = (event.target as HTMLElement).closest<HTMLElement>('[data-lightbox]');
    if (!trigger) return;
    opener = trigger;
    img.src = trigger.dataset.full!;
    img.alt = trigger.dataset.alt ?? '';
    caption.textContent = trigger.dataset.caption ?? '';
    dialog.showModal();
  });

  dialog.querySelector('[data-close]')!.addEventListener('click', () => dialog.close());

  // a click on the backdrop lands on the dialog element itself
  dialog.addEventListener('click', (event) => {
    if (event.target === dialog) dialog.close();
  });

  dialog.addEventListener('close', () => {
    opener?.focus();
    opener = null;
  });
</script>
