<dialog id="lightbox" class="lightbox modal-shell" aria-label="Photo viewer">
  <button type="button" class="modal-shell__close btn" aria-label="Close" data-close>✕</button>
  <div class="lightbox__frame modal-shell__frame">
    <figure class="lightbox__figure">
      <img class="lightbox__img" alt="" />
      <figcaption class="lightbox__caption"></figcaption>
    </figure>
  </div>
</dialog>

<style>
  .lightbox { width: min(1100px, 100vw - 24px); }
  .lightbox__figure { margin: 0; display: flex; flex-direction: column; }
  .lightbox__img {
    width: 100%;
    /* room for the close button above and the caption below */
    max-height: calc(100dvh - 150px);
    object-fit: contain;
    background: var(--ink);
  }
  .lightbox__caption { padding: 12px 16px; font-size: 15px; }
</style>

<script>
  const dialog = document.getElementById('lightbox') as HTMLDialogElement;
  const img = dialog.querySelector('img')!;
  const caption = dialog.querySelector('figcaption')!;
  let opener: HTMLElement | null = null;

  document.addEventListener('click', (event) => {
    // let ctrl/cmd/shift/middle clicks open the full image normally
    if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
    const trigger = (event.target as HTMLElement).closest<HTMLElement>('[data-lightbox]');
    if (!trigger) return;
    event.preventDefault();
    opener = trigger;
    img.src = trigger.dataset.full!;
    img.alt = trigger.dataset.alt ?? '';
    caption.textContent = trigger.dataset.caption ?? '';
    dialog.showModal();
  });

  dialog.querySelector('[data-close]')!.addEventListener('click', () => dialog.close());

  // a click on the backdrop lands on the dialog element itself
  dialog.addEventListener('click', (event) => {
    if (event.target === dialog) dialog.close();
  });

  dialog.addEventListener('close', () => {
    opener?.focus();
    opener = null;
  });
</script>
