---
import type { Contact } from '../data/types';
import { linkState } from '../lib/link';

interface Props {
  contact: Contact;
}

const { contact } = Astro.props;
const tel = `+84${contact.phone.replace(/\D/g, '').replace(/^0/, '')}`;
const linkedin = linkState(contact.linkedin);
---

<article class="contact card" data-reveal="drop">
  <h3 class="contact__title">Let's work together ✨</h3>
  <p class="contact__lead">Open to Employer Branding and Internal Communication roles. The fastest way to reach me is email.</p>
  <ul class="contact__links">
    <li><a class="btn btn--primary" href={`mailto:${contact.email}`}>✉️ {contact.email}</a></li>
    <li><a class="btn" href={`tel:${tel}`}>📞 {contact.phone}</a></li>
    <li>
      {linkedin.href ? (
        <a class="btn" href={linkedin.href} target="_blank" rel="noopener">in · LinkedIn ↗</a>
      ) : (
        <span class="btn btn--disabled" aria-disabled="true">LinkedIn coming soon</span>
      )}
    </li>
    {contact.cv && <li><a class="btn" href={contact.cv} download>📄 Download CV</a></li>}
  </ul>
</article>

<style>
  .contact {
    padding: clamp(22px, 5vw, 40px);
    background: var(--yellow);
    display: grid;
    gap: 14px;
    margin-bottom: 48px;
  }
  .contact__title { font-size: clamp(28px, 6vw, 44px); }
  .contact__lead { max-width: 56ch; font-size: 17px; }
  .contact__links {
    list-style: none;
    margin: 6px 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .contact__links .btn { max-width: 100%; overflow-wrap: anywhere; }
  .btn--disabled { box-shadow: none; color: var(--muted); cursor: default; }
  .btn--disabled:hover { transform: none; box-shadow: none; }
</style>
