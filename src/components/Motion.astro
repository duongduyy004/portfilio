<script>
  // Card tilt + shine and magnetic controls (spec 3.3, 3.4). Fine pointers only, never under reduced motion.
  import { magnetOffset, tiltFor } from '../lib/motion';

  const fine = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (fine && !reduce) {
    // ---- tilt ----
    for (const card of document.querySelectorAll<HTMLElement>('[data-tilt]')) {
      const max = Number(card.dataset.tilt) || 6;
      card.addEventListener('pointermove', (e) => {
        if (e.pointerType !== 'mouse' && e.pointerType !== 'pen') return;
        const t = tiltFor(e.clientX, e.clientY, card.getBoundingClientRect(), max);
        card.style.setProperty('--rx', String(t.rx));
        card.style.setProperty('--ry', String(t.ry));
        card.style.setProperty('--gx', `${t.gx}%`);
        card.style.setProperty('--gy', `${t.gy}%`);
        card.classList.add('is-tilting');
      });
      card.addEventListener('pointerleave', () => {
        card.classList.remove('is-tilting');
        for (const v of ['--rx', '--ry', '--gx', '--gy']) card.style.removeProperty(v);
      });
    }

    // ---- magnet ----
    const RADIUS = 64;
    const MAX = 6;
    const magnets = [...document.querySelectorAll<HTMLElement>('[data-magnet]')];
    let px = 0;
    let py = 0;
    let queued = false;
    const apply = () => {
      queued = false;
      for (const el of magnets) {
        if (el.offsetParent === null && getComputedStyle(el).position !== 'fixed') continue; // hidden
        // measure from the element's resting position, not its pulled one
        const r = el.getBoundingClientRect();
        const [tx, ty] = (el.style.translate || '0px 0px').split(' ').map((v) => parseFloat(v) || 0);
        const cx = r.left - tx + r.width / 2;
        const cy = r.top - ty + r.height / 2;
        const o = magnetOffset(px - cx, py - cy, RADIUS + Math.max(r.width, r.height) / 2, MAX);
        el.style.translate = o.x || o.y ? `${o.x.toFixed(2)}px ${o.y.toFixed(2)}px` : '';
      }
    };
    document.addEventListener(
      'pointermove',
      (e) => {
        if (e.pointerType !== 'mouse' && e.pointerType !== 'pen') return;
        px = e.clientX;
        py = e.clientY;
        if (!queued) {
          queued = true;
          requestAnimationFrame(apply);
        }
      },
      { passive: true },
    );
  }
</script>
