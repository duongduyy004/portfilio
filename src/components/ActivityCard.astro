---
import type { Activity } from '../data/types';
import ZoomImage from './ZoomImage.astro';

interface Props {
  activity: Activity;
}

const { activity } = Astro.props;
---

<article class="activity card" data-reveal="drop" data-tilt>
  {activity.photo && (
    <ZoomImage photo={activity.photo} caption={`${activity.title} — ${activity.photo.alt}`} widths={[360, 720]} sizes="(min-width: 960px) 340px, (min-width: 640px) 45vw, 90vw" />
  )}
  <div class="activity__body">
    <span class="activity__role">{activity.role}</span>
    <h3>{activity.title}</h3>
    <p>{activity.text}</p>
  </div>
</article>

<style>
  .activity { display: flex; flex-direction: column; }
  .activity :global(img) { width: 100%; aspect-ratio: 16 / 10; object-fit: cover; border-bottom: var(--border); }
  .activity__body { padding: var(--card-padding); display: grid; align-content: center; flex: 1; text-align: center; gap: var(--card-gap); }
  .activity__role {
    justify-self: center;
    font-size: 12px;
    font-weight: 700;
    background: var(--pink);
    border: var(--border);
    border-radius: 999px;
    padding: 1px 10px;
  }
  h3 { font-size: var(--card-title-size); }
  p { font-size: var(--card-body-size); line-height: 1.65; }
</style>
