---
import type { SlideDef } from '../data/slides';
import SplitWords from './SplitWords.astro';

type Props = SlideDef & { hideHeader?: boolean };

const { id, title, icon, section, tone, anchor, hideHeader = false } = Astro.props;
const headingId = `${id}-heading`;
---

<section
  id={id}
  class:list={['slide', `slide--${tone}`]}
  tabindex="-1"
  data-slide
  data-section={section}
  data-title={title}
  aria-labelledby={hideHeader ? undefined : headingId}
  aria-label={hideHeader ? title : undefined}
>
  <div class="slide__blobs" aria-hidden="true"><span></span><span></span><span></span></div>
  {anchor && <span id={anchor} class="slide__anchor"></span>}
  <div class="slide__inner container">
    {!hideHeader && (
      <header class="slide__head">
        <span class="slide__icon" aria-hidden="true" data-reveal="spin"><span>{icon}</span></span>
        <h2 id={headingId} data-reveal="words"><SplitWords text={title} /></h2>
      </header>
    )}
    <slot />
  </div>
  <span class="slide__more" aria-hidden="true" hidden><span>↓ more</span></span>
</section>

<script>
  const slideElements = [...document.querySelectorAll<HTMLElement>('[data-slide]')];
  document.documentElement.classList.add('deck-fit');
  function fitSlide(slide: HTMLElement) {
    const inner = slide.querySelector<HTMLElement>('.slide__inner');
    if (!inner) return;
    const safeBottom = innerWidth < 640 ? 56 : 0;
    const available = Math.max(1, slide.clientHeight - safeBottom - 32);
    const scale = Math.min(1, available / Math.max(1, inner.offsetHeight));
    inner.style.setProperty('--slide-fit', String(scale));
  }
  const fitAll = () => slideElements.forEach(fitSlide);
  const observer = new ResizeObserver(fitAll);
  slideElements.forEach((slide) => {
    observer.observe(slide);
    const inner = slide.querySelector<HTMLElement>('.slide__inner');
    if (inner) observer.observe(inner);
  });
  window.addEventListener('resize', fitAll);
  document.fonts.ready.then(fitAll);
  fitAll();
</script>

<style>
  .slide__head {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 20px;
  }
  .slide__icon {
    flex: none;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    padding: 3px;
    background: linear-gradient(135deg, var(--pink), var(--accent), var(--mint));
  }
  .slide__icon span {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    background: var(--card);
    font-size: 20px;
  }
  h2 { font-size: clamp(24px, 4vw, 32px); }
</style>
