---
import type { Photo, Stat } from '../data/types';
import StatCounter from './StatCounter.astro';
import ZoomImage from './ZoomImage.astro';

interface Props {
  title: string;
  stats: Stat[];
  text: string;
  image: Photo;
}

const { title, stats, text, image } = Astro.props;
---

<article class="highlight card" data-reveal="drop" data-tilt="2">
  <div class="highlight__body">
    <p class="highlight__kicker">📈 Organic growth · no paid promotion</p>
    <h3>{title}</h3>
    <div class="highlight__stats">
      {stats.map((s) => <StatCounter stat={s} />)}
    </div>
    <p class="highlight__text">{text}</p>
  </div>
  <figure class="highlight__figure">
    <ZoomImage photo={image} caption={`${title} — ${image.alt}`} widths={[640, 960, 1280, 1600, image.src.width]} sizes="(min-width: 900px) 720px, 100vw" quality={100} />
  </figure>
</article>

<style>
  .highlight {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    margin-bottom: 20px;
  }
  .highlight__body { padding: var(--card-padding); display: flex; flex-direction: column; text-align: center; gap: var(--card-gap); }
  .highlight__kicker {
    align-self: center;
    font-size: 13px;
    font-weight: 700;
    background: var(--yellow);
    border: var(--border);
    border-radius: 999px;
    padding: 3px 12px;
  }
  h3 { font-size: var(--card-title-size); }
  .highlight__stats {
    container-type: inline-size;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px 16px;
  }
  .highlight .highlight__stats :global(.stat) { container-type: normal; gap: 0; }
  .highlight .highlight__stats :global(.stat .stat__value) { font-size: clamp(19px, 7.6cqw, 66px); }
  .highlight .highlight__stats :global(.stat .stat__label) { font-size: clamp(13px, 3.2cqw, 19px); margin-top: 6px; }
  .highlight__text { max-width: 60ch; margin: auto; font-size: var(--card-body-size); line-height: 1.65; text-align: center; }
  .highlight__figure {
    margin: 0;
    overflow: hidden;
    border-top: var(--border);
    background: #EDEDED;
  }
  .highlight__figure :global(.zoom) { height: 100%; }
  .highlight__figure :global(.zoom) { display: flex; align-items: center; justify-content: center; }
  .highlight__figure :global(img) { width: 100%; height: auto; object-fit: contain; }

  @media (min-width: 900px) {
    .highlight { grid-template-columns: minmax(0, 1fr) minmax(0, 1.3fr); }
    .highlight { min-height: var(--card-desktop-height); }
    .highlight__figure { border-top: 0; border-left: var(--border); }
  }
</style>
